<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://InvoiceDetailView.title"
      focusComponent="form">
    <data>
        <instance id="invoiceDc"
                  class="com.invoicehub.entity.Invoice">
            <fetchPlan extends="_base">
                <property name="customer" fetchPlan="_base"/>
                <property name="details" fetchPlan="_base">
                    <property name="product" fetchPlan="_instance_name"/>
                </property>
            </fetchPlan>
            <loader/>
            <collection id="detailsDc" property="details"/>
        </instance>
    </data>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout>
        <formLayout id="form" dataContainer="invoiceDc">
            <textField id="numberField" property="number" readOnly="true"/>
            <datePicker id="dateField" property="date"/>
            <textField id="vatPercentageField" property="vatPercentage"/>
            <entityPicker id="customerField" property="customer">
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textArea id="remarksField" property="remarks" colspan="2"/>
        </formLayout>
        <h4 text="msg://details"/>
        <hbox id="detailsButtonsPanel">
            <button id="createDetailButton" action="detailsDataGrid.createAction"/>
            <button id="editDetailButton" action="detailsDataGrid.editAction"/>
            <button id="removeDetailButton" action="detailsDataGrid.removeAction"/>
        </hbox>
        <dataGrid id="detailsDataGrid"
                  dataContainer="detailsDc"
                  width="100%"
                  minHeight="12em">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="product"/>
                <column property="quantity"/>
                <column property="unitPrice"/>
                <column property="amount"/>
            </columns>
        </dataGrid>
        <hbox id="totalsPanel" alignItems="BASELINE">
            <textField id="amountsSumField" readOnly="true" label="msg://amountsSum"/>
            <textField id="vatField" readOnly="true" label="msg://vat"/>
            <textField id="totalField" readOnly="true" label="msg://total"/>
        </hbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="printPdfButton" text="msg://printPdf"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
