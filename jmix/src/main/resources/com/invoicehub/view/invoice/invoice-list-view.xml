<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://InvoiceListView.title"
      focusComponent="invoicesDataGrid">
    <data>
        <collection id="invoicesDc"
                    class="com.invoicehub.entity.Invoice">
            <fetchPlan extends="_base">
                <property name="customer" fetchPlan="_instance_name"/>
                <property name="details" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="invoicesDl" readOnly="true">
                <query>
                    <![CDATA[select e from ihub_Invoice e order by e.number desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="invoicesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="invoicesDataGrid.createAction"/>
                <button id="editButton" action="invoicesDataGrid.editAction"/>
                <button id="removeButton" action="invoicesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="invoicesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="invoicesDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="20em"
                  dataContainer="invoicesDc">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="number"/>
                <column property="date"/>
                <column property="customer"/>
                <column property="amountsSum"/>
                <column property="vat"/>
                <column property="total"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
