<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="com/invoicehub/liquibase/changelog/020-invoicing-model.xml">

    <changeSet id="1" author="invoicehub" context="!cuba">

        <createTable tableName="IHUB_CATEGORY">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="IHUB_CUSTOMER">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="CUSTOMER_NUMBER" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="EMAIL" type="varchar(60)"/>
            <column name="CITY" type="varchar(50)"/>
        </createTable>

        <createTable tableName="IHUB_PRODUCT">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="PRODUCT_NUMBER" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="varchar(60)">
                <constraints nullable="false"/>
            </column>
            <column name="CATEGORY_ID" type="${uuid.type}"/>
            <column name="UNIT_PRICE" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="IHUB_INVOICE">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="INVOICE_NUMBER" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="INVOICE_DATE" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="VAT_PERCENTAGE" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="CUSTOMER_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="REMARKS" type="varchar(500)"/>
        </createTable>

        <createTable tableName="IHUB_INVOICE_DETAIL">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="INVOICE_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="PRODUCT_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="QUANTITY" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="UNIT_PRICE" type="decimal(19, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="2" author="invoicehub" context="!cuba">

        <addForeignKeyConstraint baseTableName="IHUB_PRODUCT" baseColumnNames="CATEGORY_ID"
                                 constraintName="FK_IHUB_PRODUCT_ON_CATEGORY"
                                 referencedTableName="IHUB_CATEGORY" referencedColumnNames="ID"/>

        <addForeignKeyConstraint baseTableName="IHUB_INVOICE" baseColumnNames="CUSTOMER_ID"
                                 constraintName="FK_IHUB_INVOICE_ON_CUSTOMER"
                                 referencedTableName="IHUB_CUSTOMER" referencedColumnNames="ID"/>

        <addForeignKeyConstraint baseTableName="IHUB_INVOICE_DETAIL" baseColumnNames="INVOICE_ID"
                                 constraintName="FK_IHUB_INVOICE_DETAIL_ON_INVOICE"
                                 referencedTableName="IHUB_INVOICE" referencedColumnNames="ID"/>

        <addForeignKeyConstraint baseTableName="IHUB_INVOICE_DETAIL" baseColumnNames="PRODUCT_ID"
                                 constraintName="FK_IHUB_INVOICE_DETAIL_ON_PRODUCT"
                                 referencedTableName="IHUB_PRODUCT" referencedColumnNames="ID"/>

        <createIndex indexName="IDX_IHUB_INVOICE_CUSTOMER" tableName="IHUB_INVOICE">
            <column name="CUSTOMER_ID"/>
        </createIndex>

        <createIndex indexName="IDX_IHUB_INVOICE_DETAIL_INVOICE" tableName="IHUB_INVOICE_DETAIL">
            <column name="INVOICE_ID"/>
        </createIndex>

        <createIndex indexName="IDX_IHUB_INVOICE_DETAIL_PRODUCT" tableName="IHUB_INVOICE_DETAIL">
            <column name="PRODUCT_ID"/>
        </createIndex>

    </changeSet>

